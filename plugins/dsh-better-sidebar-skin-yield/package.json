{
  "name": "dsh-better-sidebar-skin-yield",
  "version": "0.1.1",
  "description": "Keeps dsh-better-sidebar controls below fake-window skin title bars without relying on CSS-module hashes.",
  "license": "MIT",
  "type": "module",
  "main": "./lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "package.json",
    "cordis.patch.yml",
    "README.md"
  ],
  "engines": {
    "node": ">=22.0.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/qtimy/dsh-cloud-server-plugins.git",
    "directory": "plugins/dsh-better-sidebar-skin-yield"
  },
  "homepage": "https://github.com/qtimy/dsh-cloud-server-plugins/tree/main/plugins/dsh-better-sidebar-skin-yield#readme",
  "dependencies": {},
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-runtime"
      ],
      "platform": "web"
    }
  }
}
